{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "barrel": {
      "type": "local",
      "command": ["/home/ipsalmy/Test/Barrel/src-tauri/target/debug/barrel-mcp"],
      "enabled": true
    },
    "argus": {
