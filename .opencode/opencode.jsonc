{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "barrel": {
      "type": "local",
      "command": ["barrel-mcp"],
      "enabled": true
    },
    "argus": {
      "type": "local",
      "command": ["python3", "argus_mcp.py"],
      "enabled": true,
      "environment": {
        "ARGUS_BARREL_BIN": "~/.local/bin/barrel-mcp",
        "ARGUS_DATA_DIR": "~/.local/share/argus"
      }
    }
  }
}
